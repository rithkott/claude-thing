+    /// Longest a profile supervisor waits between re-registration attempts.
+    const PROFILE_REREGISTER_MAX_BACKOFF: Duration = Duration::from_secs(30);
+
+    /// Re-apply the adapter properties and the pairing agent that a bluetoothd
+    /// restart drops. `new()` sets these exactly once, so without this a
+    /// restarted bluetoothd leaves the device non-discoverable and agentless
+    /// even after its RFCOMM profiles come back.
+    async fn reassert_adapter_state(session: &Session) {
+        let adapter = match session.default_adapter().await {
+            Ok(adapter) => adapter,
+            Err(e) => {
+                warn!("Could not re-acquire the Bluetooth adapter: {}", e);
+                return;
+            }
+        };
+
+        if let Err(e) = adapter.set_powered(true).await {
+            warn!("Failed to re-power the Bluetooth adapter: {}", e);
+        }
+        if let Err(e) = adapter.set_discoverable(true).await {
+            warn!("Failed to restore discoverable: {}", e);
+        }
+        if let Err(e) = adapter.set_pairable(true).await {
+            warn!("Failed to restore pairable: {}", e);
+        }
+
+        match crate::config::get_bluetooth_device_name() {
+            Ok(device_name) => {
+                if let Err(e) = adapter.set_alias(device_name.clone()).await {
+                    warn!(
+                        "Failed to restore Bluetooth device name '{}': {}",
+                        device_name, e
+                    );
+                }
+            }
+            Err(e) => warn!("Failed to get dynamic device name: {}", e),
+        }
+
+        Self::reregister_bluetooth_agent().await;
+    }
+
+    /// Same RegisterAgent call as `register_bluetooth_agent`, but tolerant of
+    /// the agent still being registered — after a bluetoothd restart we cannot
+    /// tell from here whether it survived.
+    async fn reregister_bluetooth_agent() {
+        let joined = tokio::task::spawn_blocking(|| {
+            let conn = match Connection::new_system() {
+                Ok(conn) => conn,
+                Err(e) => {
+                    warn!("Failed to connect to D-Bus to restore the agent: {}", e);
+                    return;
+                }
+            };
+
+            let agent_path = match Path::new("/org/nocturned/agent") {
+                Ok(path) => path,
+                Err(e) => {
+                    warn!("Invalid agent path: {}", e);
+                    return;
+                }
+            };
+
+            let proxy = conn.with_proxy(
+                "org.bluez",
+                "/org/bluez",
+                std::time::Duration::from_secs(10),
+            );
+
+            let registered: std::result::Result<(), dbus::Error> = proxy.method_call(
+                "org.bluez.AgentManager1",
+                "RegisterAgent",
+                (agent_path.clone(), "DisplayYesNo"),
+            );
+
+            match &registered {
+                Ok(()) => info!("Re-registered the Bluetooth pairing agent"),
+                Err(e) if e.name() == Some("org.bluez.Error.AlreadyExists") => {
+                    debug!("Bluetooth pairing agent still registered");
+                }
+                Err(e) => {
+                    warn!("Failed to re-register the Bluetooth pairing agent: {}", e);
+                    return;
+                }
+            }
+
+            let made_default: std::result::Result<(), dbus::Error> =
+                proxy.method_call("org.bluez.AgentManager1", "RequestDefaultAgent", (agent_path,));
+            if let Err(e) = made_default {
+                warn!("Failed to restore the default Bluetooth agent: {}", e);
+            }
+        })
+        .await;
+
+        if let Err(e) = joined {
+            warn!("Agent re-registration task failed: {}", e);
+        }
+    }
+
+    /// Announce whether BlueZ is currently serving one of our RFCOMM profiles,
+    /// so the UI can tell "listening" from "the record is gone" instead of
+    /// inferring it from a failed connection.
+    async fn broadcast_profile_state(
+        websocket_server: &Option<Arc<WebSocketServer>>,
+        profile: &str,
+        channel: u8,
+        registered: bool,
+    ) {
+        if let Some(ws) = websocket_server {
+            ws.broadcast_event(
+                "bluetooth.profile".to_string(),
+                serde_json::json!({
+                    "event": if registered { "registered" } else { "unregistered" },
+                    "profile": profile,
+                    "channel": channel,
+                }),
+            )
+            .await;
+        }
+    }
